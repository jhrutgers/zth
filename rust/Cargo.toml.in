[package]
name = "zth"
version = "@ZTH_VERSION@"
edition = "2021"
description = "Rust bindings for Zth"
license = "MPL-2.0"
links = "zth"
documentation = "https://jhrutgers.github.io/zth/"
readme = "README.md"
keywords = ["fiber", "ffi"]
categories = ["api-bindings", "asynchronous", "concurrency"]
repository = "https://github.com/jhrutgers/zth"
homepage = "https://github.com/jhrutgers/zth"
exclude = ["Cargo.toml.in", "CMakeLists.txt", ".cargo", "macros/Cargo.toml.in"]

[features]
default = ["std"]
std = ["dep:log", "dep:env_logger"]
bare-metal = ["panic-handler", "allocator"]
panic-handler = []
allocator = []

[dependencies]
zth_macros = { version = "@ZTH_VERSION@" }
log = { version = "0.4", optional = true }
env_logger = { version = "0.11", optional = true }

[build-dependencies]
regex = "1"
pkg-config = "0.3"
