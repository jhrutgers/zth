[package]
name = "zth"
version = "@ZTH_VERSION@"
edition = "2021"
description = "Rust bindings for Zth"
license = "MPL-2.0"
links = "zth"
documentation = "https://jhrutgers.github.io/zth/"
readme = "README.md"
keywords = ["fiber", "ffi"]
categories = ["api-bindings", "asynchronous", "concurrency"]
repository = "https://github.com/jhrutgers/zth"
homepage = "https://github.com/jhrutgers/zth"
exclude = ["Cargo.toml.in", "CMakeLists.txt", ".cargo"]

[features]
default = ["std"]
std = []

[build-dependencies]
regex = "1"
