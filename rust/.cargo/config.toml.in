[build]
target-dir = "@CMAKE_CURRENT_BINARY_DIR@"
target = "@ZTH_RUST_TARGET@"

[env]
ZTH_REPO = "@ZTH_SOURCE_DIR@"
ZTH_DIST = "@ZTH_DIST@"

[patch.crates-io]
zth_macros = { path = "macros" }

[target.@ZTH_RUST_TARGET@]
linker = "@CMAKE_CXX_COMPILER@"
rustflags = [@ZTH_RUST_FLAGS@]
