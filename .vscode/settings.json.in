{
	"editor.formatOnSave": true,
	"cmake.configureOnOpen": false,
	"files.associations": {
		"stored": "cpp",
		".clang-tidy": "yaml",
		"*.h": "cpp",
		"**/include/**": "cpp",
		"*.doxygen": "cpp"
	},
	"cSpell.words": [
		"zth"
	],
	"cSpell.diagnosticLevel": "Hint",
	"python.analysis.extraPaths": [
		"${workspaceFolder}/python"
	],
	"[cpp]": {
		"editor.defaultFormatter": "xaver.clang-format"
	},
	"[c]": {
		"editor.defaultFormatter": "xaver.clang-format"
	},
	"C_Cpp.doxygen.generatedStyle": "/*!",
	"files.exclude": {
		"**/.git": true,
		"**/dist/venv/**": true
	},
	"clang-format.executable": "clang-format",
	"cmakeFormat.env": {
		"PYTHONPATH": "${workspaceFolder}/dist/venv"
	},
	"python.analysis.typeCheckingMode": "standard",
	"python.defaultInterpreterPath": "${workspaceFolder}/dist/venv/bin/python3",
	"rust-analyzer.hover.documentation.enable": true,
	"rust-analyzer.hover.actions.enable": true,
	"rust-analyzer.cargo.allTargets": false,
	"rust-analyzer.cargo.target": "@ZTH_RUST_TARGET@",
	"rust-analyzer.cargo.noDefaultFeatures": true,
	"rust-analyzer.cargo.features": [
		@ZTH_RUST_ANALYZER_FEATURES@
	],
	"rust-analyzer.cargo.buildScripts.enable": true,
	"rust-analyzer.linkedProjects": [
		"${workspaceFolder}/rust/Cargo.toml",
		"${workspaceFolder}/examples/rust/Cargo.toml"
	],
	"vim.textwidth": 100,
	"vim.tabstop": 8,
	"[python]": {
		"editor.defaultFormatter": "ms-python.black-formatter",
	}
}
